/* MD2Card · 玻璃拟态
 * Source: https://md2card.cn/zh/editor
 * Adapted for Typora; generated by md2card/build_themes.py.
 */
@import "./md2card/base.css";

:root {
  --md2card-page-background: #161616;
  --md2card-accent: #00f2fe;
}

html, body, content {
  background: var(--md2card-page-background);
}

content {
  width: 100%;
  background: #161616;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow:
    0 8px 32px rgba(31, 38, 135, 0.2),
    0 0 0 1px rgba(255, 255, 255, 0.1) inset;
  padding: calc(var(--spacing) * 7.5) calc(var(--spacing) * 6.25);
  position: relative;
  color: rgba(255, 255, 255, 0.85);
  --highlight-color: #00f2fe;
  --highlight-bg-color: rgba(0, 242, 254, 0.1);
}

content:before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(#f00, #f0f);
  clip-path: circle(50px at 88% 95%);
}

content:after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(#2196f3, #e91e63);
  clip-path: circle(50px at 50px 50px);
}

#write {
  position: relative;
  z-index: 1;
  border-radius: 12px;
  padding: calc(var(--spacing) * 6);
  height: 100%;
  box-shadow: 20px 20px 50px rgba(0, 0, 0, 0.5);
  border-radius: 15px;
  border-top: 1px solid rgba(255, 255, 255, 0.5);
  border-left: 1px solid rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(5px);
}

#write {
  position: relative;
  z-index: 1;
}

content h1 {
  font-size: calc(var(--spacing) * 7);
  color: #00f2fe;
  margin-bottom: calc(var(--spacing) * 3.75);
  letter-spacing: 0.5px;
  font-weight: 600;
  position: relative;
  text-align: center;
}

content h1:after {
  content: "";
  position: absolute;
  bottom: calc(var(--spacing) * -2);
  left: 50%;
  transform: translateX(-50%);
  width: calc(var(--spacing) * 15);
  height: calc(var(--spacing) * 0.5);
  background: linear-gradient(90deg, #4facfe, #00f2fe);
}

content h2 {
  font-size: calc(var(--spacing) * 4);
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: calc(var(--spacing) * 6);
  font-weight: 400;
  letter-spacing: 0.5px;
  text-align: center;
  position: relative;
}

content h3 {
  display: block;
  color: #00f2fe;
  margin-bottom: calc(var(--spacing) * 1.5);
  font-size: calc(var(--spacing) * 4);
  font-weight: 600;
  letter-spacing: 0.5px;
}

content p {
  color: rgba(255, 255, 255, 0.85);
  font-size: calc(var(--spacing) * 3.75);
  position: relative;
}

content strong {
  color: #00f2fe;
  font-weight: 600;
}

content em {
  color: #00f2fe;
  font-style: italic;
}

content a {
  color: #4facfe;
  text-decoration: none;
  border-bottom: 1px dashed rgba(79, 172, 254, 0.5);
  transition: all 0.3s ease;
  position: relative;
}

content a:hover {
  color: #00f2fe;
  border-bottom: 1px solid #00f2fe;
  text-shadow: 0 0 5px rgba(0, 242, 254, 0.3);
}

content ol {
  counter-reset: item;
  padding-left: 0;
  margin: calc(var(--spacing) * 5) 0;
}

content ol > li {
  position: relative;
  counter-increment: item;
  list-style: none;
  margin-bottom: calc(var(--spacing) * 4);
  padding-left: calc(var(--spacing) * 10);
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.6;
  font-size: calc(var(--spacing) * 3.75);
}

content ol > li:before {
  content: attr(data-index);
  position: absolute;
  left: 0;
  top: calc(var(--spacing) * -0.75);
  width: calc(var(--spacing) * 7);
  height: calc(var(--spacing) * 7);
  background: rgba(79, 172, 254, 0.2);
  border: 1px solid rgba(79, 172, 254, 0.4);
  color: #4facfe;
  text-align: center;
  line-height: calc(var(--spacing) * 6.5);
  font-weight: bold;
  border-radius: 50%;
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
}

content table {
  width: 100%;
  border-collapse: collapse;
  margin: calc(var(--spacing) * 5) 0;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  overflow: hidden;
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

content th {
  background: rgba(79, 172, 254, 0.2);
  color: rgba(255, 255, 255, 0.9);
  border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  padding: calc(var(--spacing) * 3);
  font-weight: 600;
  text-align: left;
}

content td {
  color: rgba(255, 255, 255, 0.8);
  padding: calc(var(--spacing) * 3);
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

content tr:last-child td {
  border-bottom: none;
}

content tr:nth-child(even) {
  background: rgba(255, 255, 255, 0.05);
}

content pre {
  background: rgba(0, 0, 0, 0.2) !important;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 8px;
  padding: calc(var(--spacing) * 4);
  margin: calc(var(--spacing) * 5) 0;
  overflow-x: auto;
  position: relative;
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
}

content pre:before {
  content: "</>";
  position: absolute;
  top: calc(var(--spacing) * 1);
  right: calc(var(--spacing) * 2.5);
  background: rgba(0, 0, 0, 0.6);
  color: #4facfe;
  font-size: calc(var(--spacing) * 2.5);
  padding: calc(var(--spacing) * 0.5) calc(var(--spacing) * 2);
  border-radius: 4px;
  border: 1px solid rgba(79, 172, 254, 0.3);
}

content code:not(pre code) {
  background: rgba(79, 172, 254, 0.15);
  color: #00f2fe;
  padding: calc(var(--spacing) * 0.5) calc(var(--spacing) * 1.5);
  border-radius: 4px;
  font-family: "SF Mono", "Menlo", monospace;
  font-size: calc(var(--spacing) * 3.6);
  border: 1px solid rgba(79, 172, 254, 0.2);
}

content blockquote {
  background: rgba(0, 0, 0, 0.1);
  border-left: 3px solid #4facfe;
  color: rgba(255, 255, 255, 0.8);
  padding: calc(var(--spacing) * 3.75) calc(var(--spacing) * 5);
  margin: calc(var(--spacing) * 5) 0;
  font-style: italic;
  position: relative;
  border-radius: 0 8px 8px 0;
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
}

content blockquote:before {
  content: "“";
  position: absolute;
  left: calc(var(--spacing) * 2.5);
  top: calc(var(--spacing) * 1.25);
  color: rgba(79, 172, 254, 0.3);
  font-size: calc(var(--spacing) * 7.5);
  font-family: Georgia, serif;
}

content ul {
  padding-left: 0;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15px;
  margin: calc(var(--spacing) * 5) 0;
}

content ul > li::before {
  display: none;
}

content ul > li {
  margin: 0;
  flex: 1;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
  border-radius: 8px;
  padding: calc(var(--spacing) * 3.75);
  border: 1px solid rgba(255, 255, 255, 0.18);
  transition: all 0.3s ease;
}

content .task-list-item input[type="checkbox"] {
  position: static;
}

content hr {
  border: 0;
  height: calc(var(--spacing) * 0.25);
  background: linear-gradient(
    90deg,
    transparent,
    rgba(79, 172, 254, 0.5),
    transparent
  );
  margin: calc(var(--spacing) * 6.25) 0;
}

content img {
  max-width: 100%;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 8px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
}

content .info-card {
  background: rgba(79, 172, 254, 0.1);
  border: 1px solid rgba(79, 172, 254, 0.3);
  border-radius: 8px;
  padding: calc(var(--spacing) * 3.75);
  margin: calc(var(--spacing) * 5) 0;
  position: relative;
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
}

content .info-card:before {
  content: "i";
  position: absolute;
  top: calc(var(--spacing) * -2.5);
  left: calc(var(--spacing) * 3.75);
  width: calc(var(--spacing) * 5);
  height: calc(var(--spacing) * 5);
  border-radius: 50%;
  background: #4facfe;
  color: white;
  text-align: center;
  line-height: calc(var(--spacing) * 5);
  font-weight: bold;
  font-style: italic;
  font-size: calc(var(--spacing) * 3);
}

content .tag {
  display: inline-block;
  background: rgba(79, 172, 254, 0.15);
  color: #4facfe;
  padding: calc(var(--spacing) * 0.75) calc(var(--spacing) * 2.5);
  border-radius: 20px;
  font-size: calc(var(--spacing) * 3);
  margin-right: calc(var(--spacing) * 2);
  margin-bottom: calc(var(--spacing) * 2);
  border: 1px solid rgba(79, 172, 254, 0.3);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
  transition: all 0.3s ease;
}

content .tag:hover {
  background: rgba(79, 172, 254, 0.25);
  transform: translateY(-2px);
  box-shadow: 0 4px 8px rgba(79, 172, 254, 0.2);
}

content .progress-bar {
  width: 100%;
  height: calc(var(--spacing) * 1.5);
  background: rgba(255, 255, 255, 0.1);
  border-radius: 3px;
  margin: calc(var(--spacing) * 5) 0;
  overflow: hidden;
  position: relative;
}

content .progress-bar:before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 70%; 
  background: linear-gradient(90deg, #4facfe, #00f2fe);
  border-radius: 3px;
}

/* Typora is a document, not a fixed-size export card. */
#write {
  box-sizing: border-box;
  width: auto !important;
  height: auto !important;
  min-height: 100% !important;
  max-width: 920px !important;
  margin: 2rem auto 5rem !important;
  overflow: visible !important;
}
