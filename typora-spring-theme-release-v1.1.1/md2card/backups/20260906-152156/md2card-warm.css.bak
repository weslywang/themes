/* MD2Card · 温暖柔和
 * Source: https://md2card.cn/zh/editor
 * Adapted for Typora; generated by md2card/build_themes.py.
 */
@import "./md2card/base.css";

:root {
  --md2card-page-background: linear-gradient(135deg, #fff8f5 0%, #ffeae0 100%);
  --md2card-accent: #ff7e4f;
}

html, body, content {
  background: var(--md2card-page-background);
}

content {
  width: 100%;
  background: linear-gradient(135deg, #fff8f5 0%, #ffeae0 100%);
  box-shadow: 0 10px 30px rgba(255, 178, 138, 0.2);
  padding: calc(var(--spacing) * 7);
  --highlight-color: #ff7e4f;
  --highlight-bg-color: #fff0e8;
}

#write {
  position: relative;
  height: calc(var(--card-height) - calc(var(--spacing) * 20));
}

content p {
  color: #666;
  font-size: calc(var(--spacing) * 3.75);
}

content strong {
  color: #ff7e4f;
  font-weight: 600;
}

content em {
  color: #ff9d7c;
  font-style: italic;
}

content p a {
  color: #ff7e4f;
  text-decoration: none;
  border-bottom: 1px dashed #ffd3bc;
  transition: all 0.3s ease;
}

content p a:hover {
  color: #ff6a3d;
  border-bottom: 1px solid #ff9d7c;
}

content h1 {
  font-size: calc(var(--spacing) * 6.5);
  color: #ff7e4f;
  margin-bottom: calc(var(--spacing) * 2);
  font-weight: 600;
}

content h2 {
  font-size: calc(var(--spacing) * 4.5);
  color: #ff9d7c;
  margin: calc(var(--spacing) * 5) 0;
  font-weight: 400;
}

content ol > li {
  position: relative;
  list-style: none;
  margin: calc(var(--spacing) * 5) 0;
  color: #666;
  font-size: calc(var(--spacing) * 3.75);
}

content ul > li {
  position: relative;
  list-style: none;
  margin: calc(var(--spacing) * 5) 0;
  color: #666;
  font-size: calc(var(--spacing) * 3.75);
}

content li::before {
  position: absolute;
  left: calc(var(--spacing) * -8);
  top: calc(var(--spacing) * 0);
}

content ol > li:before {
  content: attr(data-index);
  background: #ff9d7c;
  color: white;
  width: calc(var(--spacing) * 6);
  height: calc(var(--spacing) * 6);
  border-radius: 50%;
  text-align: center;
  line-height: calc(var(--spacing) * 6);
  font-weight: bold;
}

content h3 {
  display: block;
  color: #ff7e4f;
  margin-bottom: calc(var(--spacing) * 1.5);
  font-size: calc(var(--spacing) * 4.25);
}

content:before {
  content: "";
  position: absolute;
  top: calc(var(--spacing) * -2.5);
  right: calc(var(--spacing) * -2.5);
  width: calc(var(--spacing) * 20);
  height: calc(var(--spacing) * 20);
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23ff9d7c" width="80" height="80"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>')
    no-repeat;
  opacity: 0.2;
  transform: rotate(15deg);
}

content table {
  box-shadow: 0 4px 15px rgba(255, 178, 138, 0.1);
}

content th {
  background-color: #fff0e8;
  color: #ff7e4f;
  border-bottom: 2px solid #ffd3bc;
}

content td {
  color: #666;
}

content tr {
  border-bottom-color: #ffeae0;
}

content tr:nth-child(even) {
  background-color: #fff8f5;
}

content pre {
  border: 1px solid #ff9d7c;
  box-shadow: 0 4px 15px rgba(255, 178, 138, 0.1);
}

content code:not(pre code) {
  background-color: #fff0e8;
  color: #ff7e4f;
}

content blockquote {
  background-color: #fff8f5;
  border-left: 4px solid #ff9d7c;
  color: #ff7e4f;
}

content ul > li:before {
  content: "";
  top: calc(var(--spacing) * 2);
  left: calc(var(--spacing) * -6);
  width: calc(var(--spacing) * 2.5);
  height: calc(var(--spacing) * 2.5);
  background-color: #ff9d7c;
  border-radius: 50%;
}

content hr {
  background: linear-gradient(to right, transparent, #ff9d7c, transparent);
}

content .card-footer {
  text-align: right;
}

content .card-footer .page {
  font-size: calc(var(--spacing) * 3);
  color: #6a737d;
}

/* Typora is a document, not a fixed-size export card. */
#write {
  box-sizing: border-box;
  width: auto !important;
  height: auto !important;
  min-height: 100% !important;
  max-width: 920px !important;
  margin: 2rem auto 5rem !important;
  overflow: visible !important;
}
