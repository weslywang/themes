/* MD2Card · 梦幻渐变
 * Source: https://md2card.cn/zh/editor
 * Adapted for Typora; generated by md2card/build_themes.py.
 */
@import "./md2card/base.css";

:root {
  --md2card-page-background: linear-gradient(135deg, #f5f7ff 0%, #e8f0ff 100%);
  --md2card-accent: #5e6fff;
}

html, body, content {
  background: var(--md2card-page-background);
}

content {
  width: 100%;
  background: linear-gradient(135deg, #f5f7ff 0%, #e8f0ff 100%);
  box-shadow: 0 15px 35px rgba(149, 175, 255, 0.2);
  padding: calc(var(--spacing) * 7.5);
  position: relative;
  --highlight-color: #5e6fff;
  --highlight-bg-color: rgba(94, 111, 255, 0.1);
}

content:before {
  content: "";
  position: absolute;
  top: calc(var(--spacing) * -12.5);
  right: calc(var(--spacing) * -12.5);
  width: calc(var(--spacing) * 37.5);
  height: calc(var(--spacing) * 37.5);
  background: linear-gradient(
    135deg,
    rgba(190, 205, 255, 0.3),
    rgba(190, 205, 255, 0)
  );
  border-radius: 50%;
}

content:after {
  content: "";
  position: absolute;
  bottom: calc(var(--spacing) * -7.5);
  left: calc(var(--spacing) * -7.5);
  width: calc(var(--spacing) * 25);
  height: calc(var(--spacing) * 25);
  background: linear-gradient(
    135deg,
    rgba(190, 205, 255, 0.3),
    rgba(190, 205, 255, 0)
  );
  border-radius: 50%;
}

#write {
  position: relative;
  z-index: 1;
  height: calc(var(--card-height) - calc(var(--spacing) * 25));
}

content p {
  color: #666;
  font-size: calc(var(--spacing) * 3.75);
}

content strong {
  color: #5e6fff;
  font-weight: 600;
}

content em {
  color: #8c9eff;
  font-style: italic;
}

content p a {
  color: #7c8dff;
  text-decoration: none;
  border-bottom: 1px dashed #d8e1ff;
  transition: all 0.3s ease;
}

content p a:hover {
  color: #5e6fff;
  border-bottom: 1px solid #a5b4ff;
}

content h1 {
  font-size: calc(var(--spacing) * 7);
  color: #5e6fff;
  margin-bottom: calc(var(--spacing) * 2);
  letter-spacing: 0.5px;
  font-weight: 600;
}

content h2 {
  font-size: calc(var(--spacing) * 4.5);
  color: #8c9eff;
  margin-bottom: calc(var(--spacing) * 7);
  font-weight: 400;
  letter-spacing: 0.5px;
}

content li {
  position: relative;
  counter-increment: item;
  list-style: none;
  margin: calc(var(--spacing) * 4) 0;
  color: #666;
  font-size: calc(var(--spacing) * 3.75);
}

content ol > li:before {
  top: 0;
  content: attr(data-index);
  background: linear-gradient(135deg, #a5b4ff, #7c8dff);
  color: white;
  width: calc(var(--spacing) * 7);
  height: calc(var(--spacing) * 7);
  border-radius: 50%;
  text-align: center;
  line-height: calc(var(--spacing) * 7);
  font-weight: bold;
  box-shadow: 0 4px 10px rgba(124, 141, 255, 0.3);
}

content h3 {
  display: block;
  color: #5e6fff;
  margin-bottom: calc(var(--spacing) * 1.5);
  font-size: calc(var(--spacing) * 4.25);
}

content table {
  box-shadow: 0 4px 15px rgba(149, 175, 255, 0.15);
}

content th {
  background: linear-gradient(135deg, #f5f7ff 0%, #e8f0ff 100%);
  color: #7c8dff;
  border-bottom: 2px solid #d8e1ff;
}

content td {
  color: #666;
}

content tr {
  border-bottom-color: #e8f0ff;
}

content tr:nth-child(even) {
  background-color: #f9faff;
}

content pre {
  border: 1px solid #e5e7eb;
  box-shadow: 0 4px 15px rgba(149, 175, 255, 0.15);
}

content code:not(pre code) {
  background-color: #e8f0ff;
  color: #5e6fff;
}

content blockquote {
  background: linear-gradient(135deg, #f5f7ff 0%, #e8f0ff 100%);
  border-left: 4px solid #7c8dff;
  color: #7c8dff;
}

content li:before {
  position: absolute;
  left: calc(var(--spacing) * -9);
  top: calc(var(--spacing) * 2);
}

content ul > li:before {
  left: calc(var(--spacing) * -7);
  content: "";
  width: calc(var(--spacing) * 2.5);
  height: calc(var(--spacing) * 2.5);
  background: linear-gradient(135deg, #a5b4ff, #7c8dff);
  border-radius: 50%;
  box-shadow: 0 2px 5px rgba(124, 141, 255, 0.3);
}

content hr {
  background: linear-gradient(to right, transparent, #7c8dff, transparent);
}

content .card-footer {
  text-align: right;
}

content .card-footer .page {
  font-size: calc(var(--spacing) * 3);
  color: #6a737d;
}

/* Typora is a document, not a fixed-size export card. */
#write {
  box-sizing: border-box;
  width: auto !important;
  height: auto !important;
  min-height: 100% !important;
  max-width: 920px !important;
  margin: 2rem auto 5rem !important;
  overflow: visible !important;
}
