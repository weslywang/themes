/* MD2Card · 紫色小红书
 * Source: https://md2card.cn/zh/editor
 * Adapted for Typora; generated by md2card/build_themes.py.
 */
@import "./md2card/base.css";

:root {
  --md2card-page-background: #8863cf;
  --md2card-accent: #8863cf;
}

html, body, content {
  background: var(--md2card-page-background);
}

content {
  width: 100%;
  box-shadow: 0 10px 25px rgba(136, 99, 207, 0.15);
  background: #8863cf;
  padding: calc(var(--spacing) * 8.75) calc(var(--spacing) * 6.25)
    calc(var(--spacing) * 6.25);
  position: relative;
  --highlight-color: #8863cf;
  --highlight-bg-color: #f5f0ff;
}

content:before {
  content: "";
  position: absolute;
  top: calc(var(--spacing) * 6);
  left: 0;
  right: 0;
  height: calc(var(--spacing) * 0.5);
  background: repeating-linear-gradient(
    90deg,
    transparent,
    transparent 15px,
    #fff 15px,
    #fff 20px
  );
}

content:after {
  content: "";
  position: absolute;
  top: calc(var(--spacing) * 2.5);
  left: 50%;
  transform: translateX(-50%);
  width: calc(var(--spacing) * 6);
  height: calc(var(--spacing) * 6);
  border-radius: 50%;
  border: 3px solid #ca6ce5;
  background: white;
  box-shadow: 0 2px 5px rgba(136, 99, 207, 0.2);
}

#write {
  position: relative;
  z-index: 1;
}

#write {
  position: relative;
  background: rgb(203, 108, 230);
  border: 2px solid #000;
  padding: calc(var(--spacing) * 2) calc(var(--spacing) * 9)
    calc(var(--spacing) * 6) calc(var(--spacing) * 4);
  height: 100%;
  transform: translate(10px, 10px);
}

#write::before {
  content: "";
  background: #fff;
  border: 2px solid #000;
  position: absolute;
  width: 100%;
  height: 100%;
  top: calc(var(--spacing) * -2.5);
  right: calc(var(--spacing) * 2.5);
}

content h1 {
  font-size: calc(var(--spacing) * 7);
  color: rgb(201, 168, 238); 
  margin-bottom: calc(var(--spacing) * 2);
  letter-spacing: 4px;
  font-weight: 600;
  text-align: center;
  z-index: 1;
  position: relative;
}

content h1:before {
  content: attr(data-text);
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  -webkit-text-stroke: 4px rgb(82, 49, 119);
  color: transparent;
}

content h2 {
  color: #333;
  margin-bottom: calc(var(--spacing) * 6);
  font-weight: 600;
  text-align: center;
  position: relative;
  padding-bottom: calc(var(--spacing) * 2.5);
}

content h2:after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: calc(var(--spacing) * 15);
  height: calc(var(--spacing) * 0.5);
  background: #8863cf;
  opacity: 0.5;
}

content p {
  color: #333;
  font-size: calc(var(--spacing) * 3.75);
}

content em {
  color: #8863cf;
  font-style: italic;
}

content p a {
  color: #8863cf;
  text-decoration: none;
  border-bottom: 1px dashed #d5c8f0;
  transition: all 0.3s ease;
}

content p a:hover {
  color: #6b4da8;
  border-bottom: 1px solid #8863cf;
}

content li {
  position: relative;
  counter-increment: item;
  list-style: none;
  margin-bottom: calc(var(--spacing) * 5);
  color: #333;
  font-size: calc(var(--spacing) * 3.75);
}

content li:before {
  content: attr(data-index);
  position: absolute;
  left: calc(var(--spacing) * -8.5);
  top: calc(var(--spacing) * -0.75);
  width: calc(var(--spacing) * 7);
  height: calc(var(--spacing) * 7);
  border-radius: 50%;
  border: 2px solid #8863cf;
  background: white;
  color: #333;
  text-align: center;
  line-height: 1.5;
  font-weight: bold;
}

content h3 {
  display: block;
  color: #333;
  margin-bottom: calc(var(--spacing) * 1.5);
  font-size: calc(var(--spacing) * 4);
  font-weight: 600;
}

content table {
  box-shadow: 0 4px 15px rgba(136, 99, 207, 0.1);
  border-radius: 8px;
  overflow: hidden;
}

content th {
  background-color: #f5f0ff;
  color: #8863cf;
  border-bottom: 2px solid #d5c8f0;
}

content td {
  color: #333;
}

content tr {
  border-bottom-color: #f5f0ff;
}

content tr:nth-child(even) {
  background-color: #fafafa;
}

content pre {
  border: 1px solid #d5c8f0;
  box-shadow: 0 4px 15px rgba(136, 99, 207, 0.1);
  background-color: #f9f7fc;
}

content code:not(pre code) {
  background-color: #f5f0ff;
  color: #8863cf;
}

content blockquote {
  background-color: #f9f7fc;
  border-left: 4px solid #8863cf;
  color: #6b4da8;
}

content ul > li {
  position: relative;
  list-style: none;
  margin-bottom: calc(var(--spacing) * 4);
}

content ul > li:before {
  content: "✦";
  color: #8863cf;
  font-size: calc(var(--spacing) * 4);
}

content hr {
  background: linear-gradient(to right, transparent, #8863cf, transparent);
  height: calc(var(--spacing) * 0.25);
  opacity: 0.5;
}

content img {
  border: 2px solid #f5f0ff;
  box-shadow: 0 4px 15px rgba(136, 99, 207, 0.1);
}

content .card-footer {
  position: relative;
}

content .card-footer .page {
  font-size: calc(var(--spacing) * 3);
  position: absolute;
  right: calc(var(--spacing) * 2.5);
  top: calc(var(--spacing) * -6);
  z-index: 100;
}

/* Typora is a document, not a fixed-size export card. */
#write {
  box-sizing: border-box;
  width: auto !important;
  height: auto !important;
  min-height: 100% !important;
  max-width: 920px !important;
  margin: 2rem auto 5rem !important;
  overflow: visible !important;
}
