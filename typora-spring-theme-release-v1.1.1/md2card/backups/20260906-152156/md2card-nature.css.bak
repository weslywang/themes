/* MD2Card · 清新自然
 * Source: https://md2card.cn/zh/editor
 * Adapted for Typora; generated by md2card/build_themes.py.
 */
@import "./md2card/base.css";

:root {
  --md2card-page-background: #f9fcf7;
  --md2card-accent: #4caf50;
}

html, body, content {
  background: var(--md2card-page-background);
}

content {
  width: 100%;
  background: #f9fcf7;
  box-shadow: 0 10px 30px rgba(142, 199, 142, 0.15);
  padding: calc(var(--spacing) * 7.5);
  --highlight-color: #4caf50;
  --highlight-bg-color: #f1f8f1;
}

#write {
  position: relative;
  color: #555;
  height: calc(var(--card-height) - calc(var(--spacing) * 20));
}

content p:has(> img) {
  padding: 0;
}

content strong {
  color: #4caf50;
  font-weight: 600;
}

content em {
  color: #81c784;
  font-style: italic;
}

content p a {
  color: #4caf50;
  text-decoration: none;
  border-bottom: 1px dashed #c8e6c9;
  transition: all 0.3s ease;
}

content p a:hover {
  color: #388e3c;
  border-bottom: 1px solid #a5d6a7;
}

content h1 {
  font-size: calc(var(--spacing) * 6.5);
  color: #4caf50;
  margin-bottom: calc(var(--spacing) * 2);
  letter-spacing: 0.5px;
  font-weight: 600;
  position: relative;
  display: inline-block;
}

content h1:after {
  content: "🌿";
  position: absolute;
  right: calc(var(--spacing) * -7.5);
  top: 0;
}

content h2 {
  font-size: calc(var(--spacing) * 4.5);
  color: #81c784;
  margin-bottom: calc(var(--spacing) * 7);
  font-weight: 400;
  letter-spacing: 0.5px;
}

content ul,
content ol {
  background: white;
  border-radius: 12px;
  padding: calc(var(--spacing) * 5) calc(var(--spacing) * 5)
    calc(var(--spacing) * 5) calc(var(--spacing) * 12);
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
}

content li {
  position: relative;
  counter-increment: item;
  list-style: none;
  margin-top: calc(var(--spacing) * 5);
  color: #555;
  font-size: calc(var(--spacing) * 3.75);
  border-bottom: 1px dashed #e8f5e9;
  padding-bottom: calc(var(--spacing) * 5);
}

content li:first-child {
  margin-top: 0;
}

content li:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

content li:before {
  content: attr(data-index);
  position: absolute;
  left: calc(var(--spacing) * -9);
  top: 0;
  background: #a5d6a7;
  color: white;
  width: calc(var(--spacing) * 7);
  height: calc(var(--spacing) * 7);
  border-radius: 50%;
  text-align: center;
  line-height: calc(var(--spacing) * 7);
  font-weight: bold;
}

content h3 {
  display: block;
  color: #4caf50;
  margin-bottom: calc(var(--spacing) * 1.5);
  font-size: calc(var(--spacing) * 4.25);
}

content table {
  box-shadow: 0 4px 15px rgba(142, 199, 142, 0.1);
  background: white;
  border-radius: 12px;
}

content th {
  background-color: #f1f8f1;
  color: #4caf50;
  border-bottom: 2px solid #c8e6c9;
}

content td {
  color: #555;
}

content tr {
  border-bottom-color: #e8f5e9;
}

content tr:nth-child(even) {
  background-color: #f9fcf7;
}

content pre {
  border: 1px dashed #a5d6a7;
  box-shadow: 0 4px 15px rgba(142, 199, 142, 0.1);
}

content code:not(pre code) {
  background-color: #f1f8f1;
  color: #4caf50;
}

content blockquote {
  background-color: white;
  border-left: 4px solid #a5d6a7;
  color: #4caf50;
  border-radius: 0 12px 12px 0;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
}

content ul > li {
  border-bottom: 1px dashed #e8f5e9;
  padding-bottom: calc(var(--spacing) * 4);
}

content ul > li:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

content ul > li:before {
  content: "🍃";
  font-size: calc(var(--spacing) * 4);
}

content hr {
  background: linear-gradient(to right, transparent, #a5d6a7, transparent);
  height: calc(var(--spacing) * 0.25);
}

content .card-footer {
  text-align: right;
}

content .card-footer .page {
  font-size: calc(var(--spacing) * 3);
  color: #6a737d;
}

/* Typora is a document, not a fixed-size export card. */
#write {
  box-sizing: border-box;
  width: auto !important;
  height: auto !important;
  min-height: 100% !important;
  max-width: 920px !important;
  margin: 2rem auto 5rem !important;
  overflow: visible !important;
}
