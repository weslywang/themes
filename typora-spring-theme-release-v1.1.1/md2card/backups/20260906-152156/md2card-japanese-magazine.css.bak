/* MD2Card · 日本杂志
 * Source: https://md2card.cn/zh/editor
 * Adapted for Typora; generated by md2card/build_themes.py.
 */
@import "./md2card/base.css";

:root {
  --md2card-page-background: #ffffff;
  --md2card-accent: #ff0033;
}

html, body, content {
  background: var(--md2card-page-background);
}

content {
  width: 100%;
  border-radius: 0;
  background: #ffffff;
  padding: calc(var(--spacing) * 7.5) calc(var(--spacing) * 6.25);
  position: relative;
  overflow: hidden;
  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
  --highlight-color: #ff0033;
  --highlight-bg-color: rgba(255, 0, 51, 0.1);
}

content:before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: calc(var(--spacing) * 15);
  height: calc(var(--spacing) * 15);
  background: #ff0033;
  transform: rotate(45deg) translate(-40px, -40px);
  z-index: 1;
}

content:after {
  content: "";
  position: absolute;
  bottom: calc(var(--spacing) * 2.25);
  right: calc(var(--spacing) * 5);
  width: calc(var(--spacing) * 10);
  height: calc(var(--spacing) * 10);
  background: #000;
  border-radius: 50%;
  opacity: 0.2;
  z-index: 1;
}

#write {
  position: relative;
  z-index: 2;
}

#write {
  position: relative;
  height: calc(var(--card-height) - calc(var(--spacing) * 25));
}

content h1 {
  font-size: calc(var(--spacing) * 7.5);
  position: relative;
  color: #000;
  margin: calc(var(--spacing) * 6.25) 0 calc(var(--spacing) * 6.25) 0;
  font-weight: 800;
  padding-left: calc(var(--spacing) * 3.75);
  padding-bottom: 0;
  border-left: 5px solid #ff0033;
}

content h1:after {
  content: "";
  display: block;
  width: calc(var(--spacing) * 10);
  height: calc(var(--spacing) * 0.75);
  background: #000;
}

content h2 {
  font-size: calc(var(--spacing) * 4.5);
  color: #ff0033;
  margin: calc(var(--spacing) * 6.25) 0 calc(var(--spacing) * 3.75) 0;
  font-weight: 700;
  letter-spacing: 1px;
  position: relative;
  display: inline-block;
  padding: 0 calc(var(--spacing) * 1.25);
  background: #fff;
  z-index: 2;
}

content h2::after {
  content: "";
  display: block;
  height: calc(var(--spacing) * 1);
  width: 100%;
  background: #ddd;
  transform: translate3d(0px, -2px, 0px);
}

content p {
  color: #333;
}

content strong {
  color: #000;
  font-weight: 700;
  background: linear-gradient(transparent 60%, rgba(255, 0, 51, 0.2) 40%);
  padding: 0 calc(var(--spacing) * 0.5);
}

content em {
  color: #ff0033;
  font-style: normal;
  font-weight: 600;
}

content p a {
  color: #000;
  text-decoration: none;
  border-bottom: 1px solid #ff0033;
  transition: all 0.2s ease;
}

content p a:hover {
  color: #ff0033;
}

content li {
  list-style: none;
  margin-bottom: calc(var(--spacing) * 3.75);
  color: #333;
  line-height: 1.6;
  font-size: calc(var(--spacing) * 4);
  position: relative;
}

content li:before {
  content: attr(data-index);
  width: calc(var(--spacing) * 6);
  height: calc(var(--spacing) * 6);
  display: block;
  background: #000;
  color: #fff;
  text-align: center;
  line-height: calc(var(--spacing) * 6);
  font-weight: bold;
  font-size: calc(var(--spacing) * 3.5);
  position: absolute;
  left: calc(var(--spacing) * -7);
  top: 0;
}

content h3 {
  display: block;
  color: #000;
  margin: calc(var(--spacing) * 5) 0 calc(var(--spacing) * 2.5) 0;
  font-size: calc(var(--spacing) * 4);
  font-weight: 700;
  letter-spacing: 0.5px;
}

content table {
  border-collapse: collapse;
  margin: calc(var(--spacing) * 5) 0;
  width: 100%;
}

content th {
  background-color: #000;
  color: #fff;
  padding: calc(var(--spacing) * 2.5);
  text-align: left;
  font-weight: 600;

  font-size: calc(var(--spacing) * 3);
  letter-spacing: 1px;
}

content td {
  color: #333;
  padding: calc(var(--spacing) * 2.5);
  border-bottom: 1px solid #eee;
}

content tr:nth-child(even) {
  background-color: #f9f9f9;
}

content pre {
  border: 1px solid #eee;
  background-color: #f9f9f9;
  padding: calc(var(--spacing) * 3.75);
  overflow-x: auto;
  font-family: "SF Mono", monospace;
  font-size: calc(var(--spacing) * 3.5);
}

content code:not(pre code) {
  background-color: #f1f1f1;
  color: #ff0033;
  padding: calc(var(--spacing) * 0.5) calc(var(--spacing) * 1);
  font-family: "SF Mono", monospace;
  font-size: calc(var(--spacing) * 3.6);
}

content blockquote {
  background-color: #fff;
  border-left: 3px solid #ff0033;
  color: #666;
  padding: calc(var(--spacing) * 3.75) calc(var(--spacing) * 5);
  margin: calc(var(--spacing) * 5) 0;
  font-style: italic;
  position: relative;
}

content blockquote:before {
  content: "“";
  display: block;
  height: calc(var(--spacing) * 0.25);
  transform: translate(0, -24px);
  color: rgba(255, 0, 51, 0.2);
  font-size: calc(var(--spacing) * 10);
  font-family: serif;
}

content ul > li:before {
  content: "";
  display: block;
  width: calc(var(--spacing) * 2);
  height: calc(var(--spacing) * 2);
  color: #ff0033;
  font-size: calc(var(--spacing) * 3);
  top: calc(var(--spacing) * 3);
  left: calc(var(--spacing) * -6);
}

content hr {
  height: calc(var(--spacing) * 0.75);
  border: none;
  background: repeating-linear-gradient(
    90deg,
    #000,
    #000 5px,
    transparent 5px,
    transparent 10px
  );
  margin: calc(var(--spacing) * 6.25) 0;
}

content img {
  max-width: 100%;
  height: auto;
  border: 5px solid #fff;
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
  transform: rotate(-1deg);
}

content .card-footer {
  text-align: right;
  font-size: calc(var(--spacing) * 3);
  color: #333;

  letter-spacing: 1px;
  border-top: 1px solid #eee;
  padding-top: calc(var(--spacing) * 3.75);
}

content .tilt-left {
  transform: rotate(-2deg);
}

content .tilt-right {
  transform: rotate(1deg);
}

content .card-header:before {
  content: "STYLE";
  position: absolute;
  top: calc(var(--spacing) * 3.75);
  right: calc(var(--spacing) * 5);
  font-size: calc(var(--spacing) * 2.5);
  color: #fff;
  background: #000;
  padding: calc(var(--spacing) * 0.75) calc(var(--spacing) * 2);
  letter-spacing: 1px;
  font-weight: bold;
  transform: rotate(3deg);
  z-index: 3;
}

content .highlight {
  background: linear-gradient(transparent 60%, rgba(255, 0, 51, 0.3) 40%);
  padding: 0 calc(var(--spacing) * 0.5);
}

/* Typora is a document, not a fixed-size export card. */
#write {
  box-sizing: border-box;
  width: auto !important;
  height: auto !important;
  min-height: 100% !important;
  max-width: 920px !important;
  margin: 2rem auto 5rem !important;
  overflow: visible !important;
}
