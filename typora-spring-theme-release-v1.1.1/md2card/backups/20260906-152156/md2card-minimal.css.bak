/* MD2Card · 简约高级灰
 * Source: https://md2card.cn/zh/editor
 * Adapted for Typora; generated by md2card/build_themes.py.
 */
@import "./md2card/base.css";

:root {
  --md2card-page-background: #ffffff;
  --md2card-accent: #1677ff;
}

html, body, content {
  background: var(--md2card-page-background);
}

content {
  width: 100%;
  background: #ffffff;
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
  padding: calc(var(--spacing) * 8);
  border: 1px solid #f0f0f0;
}

#write {
  position: relative;
  height: calc(var(--card-height) - calc(var(--spacing) * 22.5));
}

content p {
  color: #555;
}

content p a {
  color: #333;
  text-decoration: none;
  border-bottom: 1px solid #e0e0e0;
  transition: all 0.3s ease;
}

content p a:hover {
  color: #000;
  border-bottom: 1px solid #999;
}

content h1 {
  font-size: calc(var(--spacing) * 6);
  color: #333;
  margin-bottom: calc(var(--spacing) * 1.5);
  letter-spacing: 0.5px;
  font-weight: 600;
}

content h2 {
  font-size: calc(var(--spacing) * 4);
  color: #888;
  margin-bottom: calc(var(--spacing) * 2);
  font-weight: 400;
  letter-spacing: 0.5px;
}

content h2:after {
  content: "";
  width: calc(var(--spacing) * 10);
  height: calc(var(--spacing) * 0.75);
  background: #333;
  display: block;
  margin-top: calc(var(--spacing) * 2);
}

content li {
  position: relative;
  counter-increment: item;
  list-style: none;
  margin: calc(var(--spacing) * 4) 0;
  color: #555;
  font-size: calc(var(--spacing) * 4);
}

content li:before {
  content: "0" attr(data-index);
  position: absolute;
  left: calc(var(--spacing) * -7);
  top: calc(var(--spacing) * 0);
  color: #fff;
  font-weight: 600;
  font-size: calc(var(--spacing) * 3);
  background: #333;
  width: calc(var(--spacing) * 6);
  height: calc(var(--spacing) * 6);
  line-height: calc(var(--spacing) * 6);
  border-radius: 50%;
  text-align: center;
}

content h3 {
  display: block;
  color: #333;
  margin-bottom: calc(var(--spacing) * 1.5);
  font-size: calc(var(--spacing) * 4);
  font-weight: 600;
}

content table {
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
}

content th {
  background-color: #f7f7f7;
  color: #333;
  border-bottom: 2px solid #e0e0e0;
}

content td {
  color: #555;
}

content tr {
  border-bottom-color: #f0f0f0;
}

content tr:nth-child(even) {
  background-color: #fafafa;
}

content pre {
  border: 1 solid #333;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
}

content code:not(pre code) {
  background-color: #f0f0f0;
  color: #333;
}

content blockquote {
  background-color: #f7f7f7;
  border-left: 4px solid #333;
  color: #555;
}

content ul ul,
content ul ol {
  padding-left: calc(var(--spacing) * 5);
}

content ul > li:before {
  content: "";
  width: calc(var(--spacing) * 2);
  height: calc(var(--spacing) * 2);
  top: calc(var(--spacing) * 2);
  left: calc(var(--spacing) * -5);
  background-color: #333;
  border-radius: 0;
}

content hr {
  background-color: #e0e0e0;
}

content .card-footer {
  text-align: right;
}

content .card-footer .page {
  font-size: calc(var(--spacing) * 3);
}

/* Typora is a document, not a fixed-size export card. */
#write {
  box-sizing: border-box;
  width: auto !important;
  height: auto !important;
  min-height: 100% !important;
  max-width: 920px !important;
  margin: 2rem auto 5rem !important;
  overflow: visible !important;
}
