/* MD2Card · 笔记本
 * Source: https://md2card.cn/zh/editor
 * Adapted for Typora; generated by md2card/build_themes.py.
 */
@import "./md2card/base.css";

:root {
  --md2card-page-background: #f5f5f5;
  --md2card-accent: #3498db;
}

html, body, content {
  background: var(--md2card-page-background);
}

content {
  width: 100%;
  background: #f5f5f5;
  padding: calc(var(--spacing) * 6.25) calc(var(--spacing) * 6.25)
    calc(var(--spacing) * 7.5) calc(var(--spacing) * 6.25);
  position: relative;
  --highlight-color: #3498db;
  --highlight-bg-color: #f8f9fa;
}

content:before {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: calc(var(--spacing) * 5);
  width: calc(var(--spacing) * 0.5);
  background: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 10px,
    #e74c3c 10px,
    #e74c3c 15px
  );
}

content:after {
  content: "📒";
  position: absolute;
  top: calc(var(--spacing) * 0);
  left: calc(var(--spacing) * 2.5);
  font-size: calc(var(--spacing) * 6);
  transform: rotate(-10deg);
}

#write {
  position: relative;
  z-index: 1;
}

#write {
  position: relative;
  background: #fff;
  color: #34495e;
  border: 1px solid #ddd;
  padding: calc(var(--spacing) * 4);
  height: 100%;
  background-image: linear-gradient(#eee 1px, transparent 1px);
  background-size: 100% 24px;
}

content h1 {
  font-size: calc(var(--spacing) * 7);
  line-height: 1.5;
  position: relative;
  color: #2c3e50;
  margin-bottom: calc(var(--spacing) * 2);
  letter-spacing: 1px;
  font-weight: 600;
  text-align: center;
  padding-bottom: calc(var(--spacing) * 1.25);
  border-bottom: 2px dashed #3498db;
}

content h2 {
  font-size: calc(var(--spacing) * 4);
  color: #7f8c8d;
  margin-bottom: calc(var(--spacing) * 6);
  font-weight: 400;
  letter-spacing: 0.5px;
  text-align: center;
  position: relative;
  font-style: italic;
}

content h2:after {
  content: "";
  position: absolute;
  bottom: calc(var(--spacing) * -2);
  left: 50%;
  transform: translateX(-50%);
  width: calc(var(--spacing) * 10);
  height: calc(var(--spacing) * 0.5);
  background: #3498db;
}

content h3 {
  color: #34495e;
  font-weight: bold;
}

content p {
  color: #34495e;
  font-size: calc(var(--spacing) * 3.75);
  line-height: calc(var(--spacing) * 6);
  position: relative;
  z-index: 1;
}

content em {
  color: #3498db;
  font-style: italic;
}

content p a {
  color: #3498db;
  text-decoration: none;
  border-bottom: 1px dashed #3498db;
  transition: all 0.3s ease;
}

content p a:hover {
  color: #2980b9;
  border-bottom: 1px solid #2980b9;
}

content li {
  position: relative;
  counter-increment: item;
  list-style: none;
  margin-bottom: calc(var(--spacing) * 5);
  color: #34495e;
  line-height: calc(var(--spacing) * 6);
  font-size: calc(var(--spacing) * 3.75);
}

content li:before {
  content: attr(data-index);
  width: calc(var(--spacing) * 6);
  height: calc(var(--spacing) * 6);
  border-radius: 50%;
  border: 1px solid #3498db;
  background: #f8f9fa;
  color: #3498db;
  text-align: center;
  line-height: calc(var(--spacing) * 5.5);
  font-weight: bold;
  position: absolute;
  left: calc(var(--spacing) * -8);
  top: 0;
}

content strong {
  font-weight: 600;
  text-decoration: underline;
  text-decoration-color: #e74c3c;
  text-decoration-style: wavy;
  text-underline-offset: 4px;
}

content .wavy-underline {
  text-decoration-color: #e74c3c;
}

content table {
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  border-radius: 4px;
  overflow: hidden;
  margin: calc(var(--spacing) * 5) 0;
  border-collapse: collapse;
}

content th {
  background-color: #f8f9fa;
  color: #2c3e50;
  border-bottom: 2px solid #3498db;
  padding: calc(var(--spacing) * 2.5);
  font-weight: 600;
}

content td {
  color: #34495e;
  padding: calc(var(--spacing) * 2.5);
  border-bottom: 1px solid #ecf0f1;
}

content tr:nth-child(even) {
  background-color: #f8f9fa;
}

content pre {
  border: 1px solid #ecf0f1;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  background-color: #f8f9fa;
  border-radius: 4px;
  padding: calc(var(--spacing) * 4);
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  font-size: calc(var(--spacing) * 3.25);
  overflow-x: auto;
}

content code:not(pre code) {
  background-color: #f8f9fa;
  color: #e74c3c;
  padding: calc(var(--spacing) * 0.5) calc(var(--spacing) * 1.25);
  border-radius: 3px;
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  font-size: calc(var(--spacing) * 3.6);
}

content blockquote {
  background-color: #f8f9fa;
  border-left: 4px solid #3498db;
  color: #7f8c8d;
  padding: calc(var(--spacing) * 2.5) calc(var(--spacing) * 5);
  margin: calc(var(--spacing) * 5) 0;
  font-style: italic;
  position: relative;
}

content blockquote:before {
  content: "“";
  height: calc(var(--spacing) * 0.25);
  transform: translate(0px, -16px);
  display: block;
  font-size: calc(var(--spacing) * 10);
  color: rgba(52, 152, 219, 0.2);
  font-family: Georgia, serif;
}

content ul > li {
  list-style: none;
  margin-bottom: calc(var(--spacing) * 4);
  line-height: calc(var(--spacing) * 6);
}

content ul > li:before {
  content: "✎";
  color: #3498db;
  font-size: calc(var(--spacing) * 4);
}

content hr {
  border: 0;
  height: calc(var(--spacing) * 0.25);
  background: repeating-linear-gradient(
    90deg,
    transparent,
    transparent 5px,
    #3498db 5px,
    #3498db 10px
  );
  margin: calc(var(--spacing) * 6) 0;
}

content img {
  max-width: 100%;
  border: 1px solid #ecf0f1;
  border-radius: 4px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  padding: calc(var(--spacing) * 1.25);
  background: white;
}

content .note {
  background: #fff9c4;
  padding: calc(var(--spacing) * 3.75);
  margin: calc(var(--spacing) * 5) 0;
  border-radius: 4px;
  box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.1);
  position: relative;
  transform: rotate(-1deg);
}

content .note:before {
  content: "";
  position: absolute;
  top: calc(var(--spacing) * -1.25);
  left: 50%;
  transform: translateX(-50%);
  width: calc(var(--spacing) * 10);
  height: calc(var(--spacing) * 2.5);
  background: rgba(231, 76, 60, 0.5);
  border-radius: 3px;
}

content .handwritten {
  font-family: "Caveat", "Ma Shan Zheng", cursive;
  color: #2c3e50;
  font-size: calc(var(--spacing) * 4.5);
  line-height: 1.5;
  transform: rotate(-1deg);
}

content .card-footer {
  text-align: right;
}

content .card-footer .page {
  font-size: calc(var(--spacing) * 3);
}

/* Typora is a document, not a fixed-size export card. */
#write {
  box-sizing: border-box;
  width: auto !important;
  height: auto !important;
  min-height: 100% !important;
  max-width: 920px !important;
  margin: 2rem auto 5rem !important;
  overflow: visible !important;
}
