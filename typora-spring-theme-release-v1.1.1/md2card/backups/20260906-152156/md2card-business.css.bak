/* MD2Card · 商务简报
 * Source: https://md2card.cn/zh/editor
 * Adapted for Typora; generated by md2card/build_themes.py.
 */
@import "./md2card/base.css";

:root {
  --md2card-page-background: #ffffff;
  --md2card-accent: #2c7be5;
}

html, body, content {
  background: var(--md2card-page-background);
}

content {
  width: 100%;
  background: #ffffff;
  padding: calc(var(--spacing) * 6.25) calc(var(--spacing) * 5);
  font-family: "SF Pro Display", "PingFang SC", "Helvetica Neue", sans-serif;
  position: relative;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
  --highlight-color: #2c7be5;
  --highlight-bg-color: rgba(44, 123, 229, 0.1);
}

content .card-header::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: calc(var(--spacing) * 1.5);
  background: linear-gradient(90deg, #2563eb, #3b82f6, #60a5fa);
}

content .card-header::before {
  content: "";
  position: absolute;
  top: calc(var(--spacing) * 3.75);
  right: calc(var(--spacing) * 3.75);
  width: calc(var(--spacing) * 7.5);
  height: calc(var(--spacing) * 7.5);
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="%233b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="7.5 4.21 12 6.81 16.5 4.21"></polyline><polyline points="7.5 19.79 7.5 14.6 3 12"></polyline><polyline points="21 12 16.5 14.6 16.5 19.79"></polyline><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>');
  background-size: contain;
  background-repeat: no-repeat;
  opacity: 0.1;
  z-index: 1;
}

#write {
  position: relative;
  z-index: 2;
}

#write {
  position: relative;
  height: calc(var(--card-height) - calc(var(--spacing) * 20));
}

content h1 {
  font-size: calc(var(--spacing) * 6);
  position: relative;
  color: #1e3a8a;
  margin-bottom: calc(var(--spacing) * 4);
  font-weight: 600;
  padding-bottom: calc(var(--spacing) * 3);
  border-bottom: 1px solid #e5e7eb;
}

content h2 {
  font-size: calc(var(--spacing) * 4.5);
  color: #1e3a8a;
  margin-bottom: calc(var(--spacing) * 4);
  font-weight: 500;
  position: relative;
  padding: calc(var(--spacing) * 2) calc(var(--spacing) * 2)
    calc(var(--spacing) * 2) calc(var(--spacing) * 3);
  border-left: 3px solid #3b82f6;
}

content p {
  color: #334155;
  font-size: calc(var(--spacing) * 3.75);
}

content strong {
  color: #1e3a8a;
  font-weight: 600;
}

content em {
  color: #3b82f6;
  font-style: italic;
}

content p a {
  color: #2563eb;
  text-decoration: none;
  border-bottom: 1px solid rgba(37, 99, 235, 0.2);
  transition: all 0.2s ease;
}

content p a:hover {
  color: #1d4ed8;
  border-bottom: 1px solid rgba(29, 78, 216, 0.4);
}

content ul ul,
content ul ol {
  padding-left: calc(var(--spacing) * 5);
}

content li {
  position: relative;
  counter-increment: item;
  list-style: none;
  margin-bottom: calc(var(--spacing) * 3);
  color: #334155;
  line-height: 1.6;
  font-size: calc(var(--spacing) * 3.75);
}

content li:before {
  content: attr(data-index);
  width: calc(var(--spacing) * 6);
  height: calc(var(--spacing) * 6);
  background: #f1f5f9;
  color: #3b82f6;
  text-align: center;
  line-height: calc(var(--spacing) * 6);
  font-weight: 600;
  border-radius: 4px;
  display: block;
  position: absolute;
  left: calc(var(--spacing) * -7);
  top: 0;
}

content h3 {
  display: block;
  color: #1e3a8a;
  margin-bottom: calc(var(--spacing) * 1.5);
  font-size: calc(var(--spacing) * 4);
  font-weight: 600;
}

content table {
  border-collapse: collapse;
  margin: calc(var(--spacing) * 5) 0;
  width: 100%;
  border: 1px solid #e5e7eb;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
}

content th {
  background-color: #f8fafc;
  color: #1e3a8a;
  padding: calc(var(--spacing) * 2.5);
  text-align: left;
  border: 1px solid #e5e7eb;
  font-weight: 600;
}

content td {
  color: #334155;
  padding: calc(var(--spacing) * 2.5);
  border: 1px solid #e5e7eb;
}

content tr:nth-child(even) {
  background-color: #f8fafc;
}

content pre {
  border: 1px solid #e5e7eb;
  background-color: #f8fafc;
  border-radius: 4px;
  padding: calc(var(--spacing) * 3);
  overflow-x: auto;
}

content code:not(pre code) {
  background-color: #f1f5f9;
  color: #2563eb;
  padding: calc(var(--spacing) * 0.5) calc(var(--spacing) * 1);
  border-radius: 3px;
  font-family: "SF Mono", "Menlo", monospace;
  font-size: calc(var(--spacing) * 3.6);
}

content blockquote {
  background-color: #f8fafc;
  border-left: 4px solid #3b82f6;
  color: #475569;
  padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4);
  margin: calc(var(--spacing) * 4) 0;
  font-style: italic;
}

content ul > li:before {
  content: "•";
  color: #3b82f6;
  font-size: calc(var(--spacing) * 4.5);
  font-weight: bold;
}

content hr {
  height: calc(var(--spacing) * 0.25);
  border: none;
  background: #e5e7eb;
  margin: calc(var(--spacing) * 5) 0;
}

content img {
  border-radius: 4px;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
}

content .card-footer {
  text-align: right;
  font-size: calc(var(--spacing) * 3);
  color: #64748b;
  border-top: 1px solid #e5e7eb;
  line-height: 3;
}

/* Typora is a document, not a fixed-size export card. */
#write {
  box-sizing: border-box;
  width: auto !important;
  height: auto !important;
  min-height: 100% !important;
  max-width: 920px !important;
  margin: 2rem auto 5rem !important;
  overflow: visible !important;
}
