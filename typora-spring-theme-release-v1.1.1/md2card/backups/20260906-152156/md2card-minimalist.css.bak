/* MD2Card · 极简黑白
 * Source: https://md2card.cn/zh/editor
 * Adapted for Typora; generated by md2card/build_themes.py.
 */
@import "./md2card/base.css";

:root {
  --md2card-page-background: #ffffff;
  --md2card-accent: #000;
}

html, body, content {
  background: var(--md2card-page-background);
}

content {
  width: 100%;
  background: #ffffff;
  padding: calc(var(--spacing) * 7.5) calc(var(--spacing) * 6.25)
    calc(var(--spacing) * 2.5) calc(var(--spacing) * 6.25);
  position: relative;
  --highlight-color: #000;
  --highlight-bg-color: #f0f0f0;
}

content:before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: calc(var(--spacing) * 1);
  background: #000;
}

#write {
  position: relative;
  z-index: 2;
}

#write {
  position: relative;
  padding: 0;
  height: calc(var(--card-height) - calc(var(--spacing) * 20));
}

content h1 {
  font-size: calc(var(--spacing) * 7);
  position: relative;
  color: #000;
  margin: 0 0 calc(var(--spacing) * 7.5) 0;
  letter-spacing: -0.5px;
  font-weight: 700;
  line-height: 1.2;
}

content h2 {
  font-size: calc(var(--spacing) * 4.5);
  color: #000;
  margin: calc(var(--spacing) * 7.5) 0 calc(var(--spacing) * 5) 0;
  font-weight: 600;
  letter-spacing: -0.3px;
  position: relative;
  padding-bottom: calc(var(--spacing) * 2);
  border-bottom: 1px solid #eee;
}

content p {
  color: #333;
  font-size: calc(var(--spacing) * 4);
}

content strong {
  color: #000;
  font-weight: 600;
}

content em {
  font-style: italic;
  color: #555;
}

content p a {
  color: #000;
  text-decoration: none;
  border-bottom: 1px solid #000;
  transition: all 0.2s ease;
}

content p a:hover {
  opacity: 0.7;
}

content li {
  position: relative;
  counter-increment: item;
  list-style: none;
  margin-bottom: calc(var(--spacing) * 3);
  color: #333;
  line-height: 1.6;
  font-size: calc(var(--spacing) * 4);
}

content li:before {
  content: attr(data-index);
  position: absolute;
  left: calc(var(--spacing) * -7);
  top: calc(var(--spacing) * 0);
  color: #fff;
  font-weight: 600;
  font-size: calc(var(--spacing) * 3);
  background: #000;
  width: calc(var(--spacing) * 6);
  height: calc(var(--spacing) * 6);
  line-height: calc(var(--spacing) * 6);
  border-radius: 50%;
  text-align: center;
  font-weight: 600;
}

content h3 {
  display: block;
  color: #000;
  margin: calc(var(--spacing) * 6) 0 calc(var(--spacing) * 2) 0;
  font-size: calc(var(--spacing) * 4);
  font-weight: 600;
}

content table {
  border-collapse: collapse;
  margin: calc(var(--spacing) * 6.25) 0;
  width: 100%;
  border-top: 1px solid #000;
  border-bottom: 1px solid #000;
}

content th {
  background-color: #fff;
  color: #000;
  background: rgba(0, 0, 0, 0.05);
  padding: calc(var(--spacing) * 3) calc(var(--spacing) * 2);
  text-align: left;
  font-weight: 600;
  border-bottom: 1px solid #000;
}

content td {
  color: #333;
  padding: calc(var(--spacing) * 3) calc(var(--spacing) * 2);
  border-bottom: 1px solid #eee;
}

content tr:nth-child(even) {
  background-color: #f9f9f9;
}

content pre {
  border: 1px solid #eee;
  background-color: #f9f9f9;
  padding: calc(var(--spacing) * 3.75);
  overflow-x: auto;
  font-size: calc(var(--spacing) * 3.5);
}

content code:not(pre code) {
  background-color: #f5f5f5;
  color: #000;
  padding: calc(var(--spacing) * 0.5) calc(var(--spacing) * 1);
  font-size: calc(var(--spacing) * 3.6);
}

content blockquote {
  background-color: #fff;
  border-left: 2px solid #000;
  color: #555;
  padding: calc(var(--spacing) * 3.75) calc(var(--spacing) * 5);
  margin: calc(var(--spacing) * 5) 0;
  font-style: italic;
}

content ul > li:before {
  content: "";
  width: calc(var(--spacing) * 2);
  height: calc(var(--spacing) * 2);
  left: calc(var(--spacing) * -5);
  top: calc(var(--spacing) * 2);
  background-color: #000;
}

content hr {
  height: calc(var(--spacing) * 0.25);
  border: none;
  background: #eee;
  margin: calc(var(--spacing) * 7.5) 0;
}

content img {
  max-width: 100%;
  height: auto;
  border: none;
}

content .card-footer {
  color: #999;
  border-top: 1px solid #eee;
  text-align: right;
}

content .highlight {
  background-color: var(--highlight-bg-color);
  color: var(--highlight-color);
  padding: 0 calc(var(--spacing) * 0.75);
}

/* Typora is a document, not a fixed-size export card. */
#write {
  box-sizing: border-box;
  width: auto !important;
  height: auto !important;
  min-height: 100% !important;
  max-width: 920px !important;
  margin: 2rem auto 5rem !important;
  overflow: visible !important;
}
